# Talent OS — PostgreSQL credentials.
#
# Kept in their own file, separate from talent-os/.env, so DB access can be
# rotated/audited independently of the app's other secrets (API keys, JWT
# secret, SMTP, etc). Consumed via `env_file` by both docker-compose.yml
# (root, deployed) and talent-os/docker-compose.yml (reference).
#
# Copy to talent-os/postgres.env and fill in the real values. Never commit
# the real file -- it's gitignored (see .gitignore).
#
# On the VPS this file is auto-generated from the existing talent-os/.env
# the first time .github/workflows/deploy.yml (or scripts/deploy.sh /
# start.sh) runs after this change lands, so a fresh install is the only
# time you need to create it by hand.

POSTGRES_DB=recruitment_db
POSTGRES_USER=talentos_write
POSTGRES_PASSWORD=
