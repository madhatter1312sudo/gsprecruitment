# Talent OS — Backend environment template.
# Copy to .env and fill in real values. Never commit the real .env.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_db
POSTGRES_USER=talentos_write
POSTGRES_PASSWORD=

# ── Redis / ARQ worker (root docker-compose.yml `redis` + `worker`
#    services -- talent-os/backend/worker.py). Default matches the
#    compose service DNS name; only needs overriding for local dev. ────────
REDIS_URL=redis://redis:6379/0

# ── Internal API key (X-API-Key header on /api/candidates, /api/jobs,
#    /api/matches, /api/apollo) ─────────────────────────────────────────────
API_KEY=

# ── OpenRouter (all LLM calls go through this, no models hosted locally) ───
OPENROUTER_API_KEY=

# ── Apollo.io (candidate/company sourcing) ─────────────────────────────────
APOLLO_API_KEY=

# ── SMTP (Google Workspace, STARTTLS) — used by services/mailer.py for
#    transactional email (password reset, welcome, approved outreach sends).
#    Leave empty to fall back to the Gmail API/OAuth EmailService below
#    (safe to deploy before these are set). SMTP_USER is a full Workspace
#    mailbox address; SMTP_PASS is an app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google OAuth (Gmail API, for transactional email sending) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Cloudflare R2 (CV file storage, S3-compatible) ──────────────────────────
# When any of these are empty, the app falls back to the legacy local-disk
# CV path (/app/uploads/cv) unchanged -- safe to deploy before these are set.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
LOG_LEVEL=INFO

# ── CORS (comma-separated, no wildcards) ───────────────────────────────────
# Production default (core/config.py) is the two real origins below.
# For local/Expo dev, override with something like:
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006,exp://localhost:8081
CORS_ORIGINS=https://gsprecruitment.nl,https://www.gsprecruitment.nl

# ── Auth ─────────────────────────────────────────────────────────────────
# jwt_secret must be at least 32 random characters -- app refuses to start
# below that length or at the placeholder default (see core/config.py).
JWT_SECRET=
WEBHOOK_SECRET=
