# Talent OS — Backend environment template.
# Copy to .env and fill in real values. Never commit the real .env.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_db
POSTGRES_USER=talentos_write
POSTGRES_PASSWORD=

# ── Redis / Celery (only used if the celery-worker/celery-beat services
#    from talent-os/docker-compose.yml are actually deployed -- they are
#    NOT part of the current production stack) ─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=2

# ── Internal API key (X-API-Key header on /api/candidates, /api/jobs,
#    /api/matches, /api/apollo) ─────────────────────────────────────────────
API_KEY=

# ── OpenRouter (all LLM calls go through this, no models hosted locally) ───
OPENROUTER_API_KEY=

# ── Apollo.io (candidate/company sourcing) ─────────────────────────────────
APOLLO_API_KEY=
# Off by default (WS-C.3a) -- set true to let services/scheduler.py register
# the daily Apollo search/enrich jobs at all. Also gated per-run by the
# admin-editable system_settings.apollo_sync_enabled DB flag.
APOLLO_SYNC_ENABLED=false

# ── Retention (WS-E.8/WS-E.10, core/retention.py) ───────────────────────────
# No env flag here any more. RETENTION_PURGE_ENABLED used to gate a daily
# job that could anonymise/delete rows by itself; the owner ended that
# (retention-kolommen branch, fifth round) -- the monthly job
# (services/scheduler.py generate_retention_review()) only ever queues
# people for a human's sign-off (GET/POST /api/v1/admin/retention/review*),
# so it always runs, unconditionally.

# ── E-mail (WS3, services/email_service.py) ─────────────────────────────────
# EMAIL_PROVIDER kiest tussen gmail (huidig gedrag, Gmail API/OAuth
# hieronder) en smtp (SMTP_* hieronder). Default gmail: een bestaande
# deploy blijft ongewijzigd zonder deze sectie in te vullen.
EMAIL_PROVIDER=gmail
# Afzender op elke uitgaande mail. Default is het huidige adres. Het
# subdomeinadres no-reply@mail.gsprecruitment.nl pas zetten na
# docs/EMAIL-SETUP.md.
EMAIL_FROM=GSP Recruitment <info@gsprecruitment.nl>
EMAIL_REPLY_TO=info@gsprecruitment.nl
# Interne melding aan de eigenaar bij een nieuwe registratie, Google-
# aanmelding, lead of talentpool-bevestiging (services/notify.py). Leeg
# (default) = geen eigenaarsmail, alleen Telegram zoals nu.
OWNER_NOTIFY_EMAIL=

# ── SMTP (alleen actief als EMAIL_PROVIDER=smtp hierboven; zie
#    docs/EMAIL-SETUP.md voor de omschakeling naar het subdomein) ───────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google OAuth (Gmail API voor verzenden, en Google Sign-In hieronder --
#    zelfde cliënt; zie docs/GOOGLE-SIGNIN-SETUP.md voor het advies om voor
#    Sign-In een aparte OAuth-cliënt te gebruiken) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Moet exact overeenkomen met de geautoriseerde redirect-URI in Google
# Cloud Console (docs/GOOGLE-SIGNIN-SETUP.md).
GOOGLE_REDIRECT_URI=https://api.gsprecruitment.nl/api/auth/google/callback
# Basis-URL waar de browser na Google Sign-In naar teruggaat.
FRONTEND_URL=https://gsprecruitment.nl

# ── Cloudflare R2 (CV file storage, S3-compatible) ──────────────────────────
# When any of these are empty, the app falls back to the legacy local-disk
# CV path (/app/uploads/cv) unchanged -- safe to deploy before these are set.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Sentry error monitoring (WS-E.9) ─────────────────────────────────────
# Empty by default -- Sentry is fully disabled (core/monitoring.py never
# calls sentry_sdk.init()) until this is set. When set: send_default_pii
# is forced off and every event is scrubbed of e-mail/name-shaped fields
# before it leaves the process (core/monitoring.py's before_send hook) --
# see that file's docstring. Trace sampling is fixed at 10% (not
# configurable via env).
SENTRY_DSN=
# Tag on every Sentry event -- e.g. production, staging.
SENTRY_ENVIRONMENT=production

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
LOG_LEVEL=INFO

# ── CORS (comma-separated, no wildcards) ───────────────────────────────────
CORS_ORIGINS=https://gsprecruitment.nl,https://www.gsprecruitment.nl
# Local dev only: set true to also allow localhost/Expo dev-server origins
# on top of CORS_ORIGINS above. MUST stay false (or unset) in production.
DEV_MODE=false

# ── Auth ─────────────────────────────────────────────────────────────────
# jwt_secret must be at least 32 random characters -- app refuses to start
# below that length or at the placeholder default (see core/config.py).
JWT_SECRET=
WEBHOOK_SECRET=

# ── MFA (WS-E.12, admin TOTP) ────────────────────────────────────────────
# 32-byte urlsafe-base64 Fernet key -- generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this set, the app still boots, but POST /api/auth/mfa/setup
# returns 503 (MFA cannot be enabled) until it's provided.
MFA_ENC_KEY=
# When true, an admin who hasn't enabled MFA gets 403 mfa_setup_required
# from every /api/v1/admin/* route once MFA_GRACE_UNTIL has passed.
# Defaults false -- turning this on does NOT retroactively lock out the
# only admin account; set MFA_GRACE_UNTIL to give existing admins time to
# run the setup flow first.
MFA_REQUIRED_FOR_ADMIN=false
# ISO 8601 date/datetime (e.g. 2026-10-01) admin endpoints stay open
# until, once MFA_REQUIRED_FOR_ADMIN=true. Empty = no grace period.
MFA_GRACE_UNTIL=

# ── Backups (talent-os/scripts/backup.sh, restore.sh) ───────────────────────
# See docs/BACKUP-RESTORE.md for full setup.
# Local directory backups are written to before the retention prune / rclone
# upload. Needs to exist and be writable by the cron user.
BACKUP_DIR=/var/backups/gsp
# Absolute path to a passphrase file used for `gpg --symmetric`. MUST be
# mode 600 and MUST live outside this repo (e.g. /etc/gsp/backup-passphrase)
# -- it is a secret, never commit it. Required unless BACKUP_GPG_RECIPIENT
# is set instead.
BACKUP_PASSPHRASE_FILE=
# GPG key ID/email to encrypt backups to instead of a passphrase (public-key
# mode). If set, this takes priority over BACKUP_PASSPHRASE_FILE and the
# corresponding secret key must be present to decrypt/restore.
BACKUP_GPG_RECIPIENT=
# How many local copies of each backup kind (db, uploads) to retain before
# older ones are deleted. Off-VPS copies via rclone are unaffected.
BACKUP_KEEP=7
# rclone remote:path to push backups to off-VPS (Hetzner Storage Box, any
# S3-compatible bucket, etc. -- configure the remote yourself with
# `rclone config`; this repo does not pick a vendor). Leave empty to keep
# backups local-only (not recommended -- see docs/BACKUP-RESTORE.md).
BACKUP_RCLONE_REMOTE=
# Telegram bot used for backup-failure alerts (backup.sh) and the
# backup-freshness GitHub Action. Can reuse the same bot/chat as the
# uptime check (.github/workflows/uptime.yml) -- these are host-side env
# vars, separate from the identically-named GitHub Actions secrets used
# in CI workflows.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
